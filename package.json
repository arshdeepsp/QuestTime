{
  "name": "productivitycraft",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "serve": "npm run build && npx --yes http-server dist -p 8080 -c-1",
    "test": "npm run build && playwright test",
    "format": "prettier --write src/js src/styles src/firebase build.mjs",
    "format:check": "prettier --check src/js src/styles src/firebase build.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/add-native.cjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "firebase": "^12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "1.56.0",
    "esbuild": "^0.25.12",
    "prettier": "3.6.2"
  }
}
